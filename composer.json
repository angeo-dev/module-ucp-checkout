{
    "name": "angeo/module-ucp-checkout",
    "description": "UCP checkout for Magento 2 (dev.ucp.shopping.checkout + discount + fulfillment, spec 2026-08-25). AI agents create, update and cancel real checkout sessions over REST and see live shipping rates; payment is handed off to the store's own checkout page via continue_url. No card data, no PCI scope.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "ucp",
        "universal-commerce-protocol",
        "checkout",
        "agentic-commerce",
        "ai-agents",
        "google",
        "gemini",
        "adobe-commerce"
    ],
    "homepage": "https://angeo.dev",
    "support": {
        "issues": "https://github.com/angeo-dev/module-ucp-checkout/issues",
        "email": "support@angeo.dev"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-json": "*",
        "angeo/module-ucp": "^2.2",
        "magento/framework": ">=103.0.6 <104",
        "magento/module-store": ">=101.1.6 <102",
        "magento/module-catalog": ">=104.0.6 <105",
        "magento/module-configurable-product": ">=100.4.6 <101",
        "magento/module-quote": ">=101.2.6 <102",
        "magento/module-checkout": ">=100.4.6 <101",
        "magento/module-directory": ">=100.4.6 <101",
        "magento/module-customer": ">=103.0.6 <104",
        "magento/module-sales": ">=103.0.6 <104"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^40.0 || ^41.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "suggest": {
        "angeo/module-ucp-catalog": "UCP catalog search and lookup — agents find the items they then put in a checkout"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\UcpCheckout\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "mage-os/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "php-http/discovery": false
        }
    }
}
