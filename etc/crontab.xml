<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="angeo_ucp_checkout_webhooks" instance="Angeo\UcpCheckout\Cron\SendWebhooks" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="angeo_ucp_checkout_cleanup" instance="Angeo\UcpCheckout\Cron\Cleanup" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
