<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        One row per UCP checkout session. The quote is the source of truth for
        items and totals; this row maps the UCP id to the quote and keeps what
        the quote cannot: status, the continue_url token, and the last
        response of a terminal session (so Get still answers after the quote
        is gone).
    -->
    <table name="angeo_ucp_checkout_session" resource="checkout" engine="innodb"
           comment="Angeo UCP checkout sessions">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="session_id" nullable="false" length="64" comment="UCP checkout id"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="incomplete"/>
        <column xsi:type="varchar" name="agent_profile" nullable="true" length="512"/>
        <column xsi:type="varchar" name="continue_token" nullable="false" length="64"/>
        <column xsi:type="text" name="item_refs" nullable="true" comment="JSON: quote item id => requested item id"/>
        <column xsi:type="text" name="pending_messages" nullable="true" comment="JSON: messages from the last write"/>
        <column xsi:type="mediumtext" name="snapshot" nullable="true" comment="JSON: last response once terminal"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="order_increment_id" nullable="true" length="50"/>
        <column xsi:type="varchar" name="order_url" nullable="true" length="512" comment="order.permalink_url"/>
        <column xsi:type="varchar" name="destination_id" nullable="true" length="64" comment="Fulfillment destination id the agent sent"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ANGEO_UCP_CHECKOUT_SESSION_SESSION_ID">
            <column name="session_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ANGEO_UCP_CHECKOUT_SESSION_CONTINUE_TOKEN">
            <column name="continue_token"/>
        </constraint>
        <index referenceId="ANGEO_UCP_CHECKOUT_SESSION_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="ANGEO_UCP_CHECKOUT_SESSION_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>

    <!--
        Order webhooks to deliver (UCP order capability). The order entity is
        built at send time, so each delivery carries the current state.
    -->
    <table name="angeo_ucp_order_webhook" resource="checkout" engine="innodb"
           comment="Angeo UCP order webhook queue">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="event_id" nullable="false" length="64" comment="Webhook-Id"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="session_id" nullable="false" length="64"/>
        <column xsi:type="varchar" name="event" nullable="false" length="32"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="smallint" name="last_status" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="last_error" nullable="true" length="255"/>
        <column xsi:type="timestamp" name="next_attempt_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ANGEO_UCP_ORDER_WEBHOOK_EVENT_ID">
            <column name="event_id"/>
        </constraint>
        <index referenceId="ANGEO_UCP_ORDER_WEBHOOK_STATUS_NEXT" indexType="btree">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
    </table>

    <!--
        Idempotency-Key store (UCP REST binding: keep at least 24 hours,
        replay on the same body, 409 on a different body).
    -->
    <table name="angeo_ucp_checkout_idempotency" resource="checkout" engine="innodb"
           comment="Angeo UCP checkout idempotency keys">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="operation" nullable="false" length="32"/>
        <column xsi:type="varchar" name="idempotency_key" nullable="false" length="255"/>
        <column xsi:type="varchar" name="session_id" nullable="false" length="64" default="" comment="Empty for create: NULL would defeat the unique key"/>
        <column xsi:type="varchar" name="request_hash" nullable="false" length="64"/>
        <column xsi:type="smallint" name="http_status" unsigned="true" nullable="false"/>
        <column xsi:type="mediumtext" name="response_body" nullable="false"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ANGEO_UCP_CHECKOUT_IDEMPOTENCY_OP_KEY_SESSION">
            <column name="operation"/>
            <column name="idempotency_key"/>
            <column name="session_id"/>
        </constraint>
        <index referenceId="ANGEO_UCP_CHECKOUT_IDEMPOTENCY_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
