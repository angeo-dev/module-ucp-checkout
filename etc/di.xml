<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Tell Angeo_Ucp that checkout and its discount extension are really
        served. Without this, the profile leaves them out even when the admin
        toggles are on (Angeo_Ucp 2.2.0+).
    -->
    <type name="Angeo\Ucp\Model\Config">
        <arguments>
            <argument name="implementations" xsi:type="array">
                <item name="dev.ucp.shopping.checkout" xsi:type="boolean">true</item>
                <item name="dev.ucp.shopping.discount" xsi:type="boolean">true</item>
                <item name="dev.ucp.shopping.fulfillment" xsi:type="boolean">true</item>
                <item name="dev.ucp.shopping.order" xsi:type="boolean">true</item>
            </argument>
        </arguments>
    </type>
</config>
