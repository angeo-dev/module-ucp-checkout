<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Router for {endpoint}/checkout-sessions/* and the continue_url page.
        Frontend area only, like Angeo_Ucp and Angeo_UcpCatalog.
    -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="angeo_ucp_checkout" xsi:type="array">
                    <item name="class" xsi:type="string">Angeo\UcpCheckout\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">23</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
